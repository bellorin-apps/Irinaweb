{
  "name": "irinaweb-lint",
  "private": true,
  "description": "Linters de JS y CSS del tema (PLAN 5.5). No se despliegan. Uso: npm ci && npm run lint",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "cd ../.. && eslint --config tools/lint/eslint.config.cjs wp-content/themes/irina-gonzalez/assets/js",
    "lint:css": "stylelint --config stylelint.config.cjs \"../../wp-content/themes/irina-gonzalez/assets/css/*.css\""
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "globals": "15.14.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "17.0.0"
  }
}
