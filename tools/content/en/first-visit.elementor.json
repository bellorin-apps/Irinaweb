        "settings": {
          "eyebrow": "Frequently asked questions",
          "title": "<b>Cost,</b> payments and <em>insurance</em>",
          "bg_image": {
            "id": "__PC_BG_ID__",
            "url": "__PC_BG_URL__"
          },
          "bg_pos": "bottom",
          "items": [
            {
              "_id": "52dc446",
              "pregunta": "How much does a visit cost?",
              "text": "We confirm the cost when you book via WhatsApp. Surgeries and tests are quoted after the evaluation."
            },
            {
              "_id": "b4e56b5",
              "pregunta": "Do you accept health insurance?",
              "text": "We see private patients and offer reimbursement with Mexican private health insurance; Dr. Irina provides the paperwork for your insurer."
            },
            {
              "_id": "0115e2d",
              "pregunta": "How can I pay?",
              "text": "Cash, card and bank transfer. Invoices available."
            },
            {
              "_id": "fd2ac46",
              "pregunta": "Are online visits available?",
              "text": "Only for follow-up of patients already evaluated in the office."
            },
            {
              "_id": "fdd9ad9",
              "pregunta": "Do you see children?",
              "text": "Yes, from birth."
            },
            {
              "_id": "f0088c0",
              "pregunta": "In what language are visits?",
              "text": "Consultations are in Spanish."
            },
            {
              "_id": "81846a9",
              "pregunta": "Where is the office and is there parking?",
              "text": "CAB Medical Headquarters, Av. Paseo de los Leones 2341, Office 6, 2nd floor, Cumbres 2.º Sector, Monterrey. Free parking; elevator and wheelchair access."
            }
          ]
        },
        "elements": []
      }
