          "items": [
            {
              "_id": "997faa8",
              "pregunta": "¿Necesito ir a una clínica del sueño?",
              "text": "La valoración y el estudio en casa se coordinan desde el consultorio; la Dra. realiza e interpreta el estudio. Texto pendiente de revisión de la Dra."
            },
            {
              "_id": "220b718",
              "pregunta": "¿Apnea del sueño: otorrino o neumólogo?",
              "text": "Cuando la causa está en la vía aérea superior (nariz, paladar, amígdalas), el otorrinolaringólogo puede diagnosticar y tratar la obstrucción. Texto pendiente de revisión de la Dra."
            },
            {
              "_id": "7b81796",
              "pregunta": "¿Hay tratamiento sin CPAP?",
              "text": "Según el caso: cirugía de paladar o nasal, terapia posicional, dispositivo de avance mandibular. Se decide con el estudio del sueño. Texto pendiente de revisión de la Dra."
            }
          ]
        },
