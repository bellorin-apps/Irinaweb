# Sin índice ni listado; config.php nunca se sirve.
Options -Indexes
<Files "config.php">
  Require all denied
</Files>
Header set X-Robots-Tag "noindex, nofollow"

# D-076/D-095: el texto de las páginas (y de la versión inglesa) lo sirve revisar.php con token; los JSON no se sirven directo.
<FilesMatch "^paginas(-en)?\.json$">
  Require all denied
</FilesMatch>
